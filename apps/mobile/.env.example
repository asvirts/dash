# Supabase project (Settings → API). Leave blank to run in guest (on-device) mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the deployed RepRelay web app, which serves /api/detect for AI gym scans.
# For local dev on a phone use your computer's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=
