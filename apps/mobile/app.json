{
  "expo": {
    "name": "RepRelay",
    "slug": "reprelay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reprelay",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0c0a",
    "ios": {
      "bundleIdentifier": "com.reprelay.app",
      "supportsTablet": false,
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.reprelay.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0c0a",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0c0a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RepRelay uses your photos and videos of a gym to detect which equipment is available.",
          "cameraPermission": "RepRelay uses the camera to scan a gym's equipment and adapt your workout.",
          "microphonePermission": "RepRelay records video of a gym to detect its equipment. Audio isn't used."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
