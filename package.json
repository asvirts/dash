{
  "name": "anygym",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "site": "npm run dev -w @anygym/web",
    "mobile": "npm run start -w @anygym/mobile",
    "build:site": "npm run build -w @anygym/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @anygym/core"
  },
  "engines": { "node": ">=20" }
}
