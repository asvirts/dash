{
  "name": "reprelay",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "web": "npm run dev -w @reprelay/web",
    "mobile": "npm run start -w @reprelay/mobile",
    "build:web": "npm run build -w @reprelay/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @reprelay/core"
  },
  "engines": { "node": ">=20" }
}
